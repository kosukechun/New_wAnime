# ローカルは npm run setup がランダムなパスワードで .env を作成します。
DATABASE_URL=postgresql://wanime:CHANGE_ME@localhost:5432/wanime
POSTGRES_USER=wanime
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wanime
APP_URL=http://localhost:3000
# 本番: 取得したドメイン (例 anime.example.com)
DOMAIN=localhost
ACME_EMAIL=you@example.com
# TMDB「API Read Access Token」。キーは NEXT_PUBLIC_ にしない。
TMDB_READ_TOKEN=
# AniList の利用許諾を得た場合だけ true。
ANILIST_ENABLED=false
ANILIST_PERMISSION_CONFIRMED=false
# MAL 公式APIのアプリケーション Client ID (任意)
MAL_CLIENT_ID=
SYNC_INTERVAL_HOURS=24
SYNC_MAX_WORKS=160
COLLECTOR_USER_AGENT=New_wAnime/1.0 (personal schedule discovery)
# Caddy 配下のみ true。開発PCでは false。
TRUST_PROXY=false
REGISTRATION_ENABLED=true
